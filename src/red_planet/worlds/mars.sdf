<include>
  <uri>model://martian_sky</uri>
  <pose>0 0 0 0 0 0</pose>
  <scale>0.7 0.7 0.7</scale>
</include>

    <!-- Terrain -->
    <include>
      <uri>
        model://martian_surface
      </uri>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Object -->
    <include>
      <uri>
        model://martian_rocks0
      </uri>
      <pose>-0.4 -3.9 0.22 0 0 0</pose>
    </include>
    
    <include>
    <uri>model://martian_rock_01</uri>
    <name>martian_rock_01</name>
    <pose>5 3 1.09 0 0 0</pose>
</include>
    
