    <light type="directional" name="mars_sun">
  <!-- The dome should not create shadows -->
  <cast_shadows>false</cast_shadows>

  <!-- Directional lights use direction, not position, for lighting -->
  <direction>-0.35 0.45 -0.82</direction>

  <!-- Slightly warm dusty sunlight -->
  <diffuse>1.0 0.72 0.52 1</diffuse>

  <!-- Keep highlights subtle; Mars terrain should not look glossy -->
  <specular>0.05 0.03 0.02 1</specular>

  <!-- Moderate direct light; ambient light handles the fill -->
  <intensity>0.75</intensity>
</light>

