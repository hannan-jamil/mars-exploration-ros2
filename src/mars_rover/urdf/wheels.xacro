<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel"
               params="wheel_name parent wheel_mesh motor_mesh x y z">

    <!-- ===================================================== -->
    <!-- FIXED MOTOR LINK                                      -->
    <!-- ===================================================== -->

    <link name="${wheel_name}_motor_link">

      <visual>
        <origin xyz="0 0 0"
                rpy="0 0 0"/>

        <geometry>
          <mesh filename="package://mars_rover/meshes/visual/${motor_mesh}.obj"/>
        </geometry>

        <material name="Silver"/>
      </visual>

    </link>


    <!-- Motor remains fixed to base_link.
         Its mesh already contains its physical position. -->

    <joint name="${wheel_name}_motor_joint"
           type="fixed">

      <parent link="${parent}"/>
      <child link="${wheel_name}_motor_link"/>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

    </joint>


    <!-- ===================================================== -->
    <!-- WHEEL LINK                                            -->
    <!-- ===================================================== -->

    <link name="${wheel_name}_wheel_link">

      <visual>

        <!--
          IMPORTANT:

          The OBJ already contains its world/rover position.
          The wheel link frame will now be placed at the axle
          by the wheel joint below.

          Therefore subtract the axle position here so the
          visual stays exactly where it is.
        -->

        <origin xyz="${-x} ${-y} ${-z}"
                rpy="0 0 0"/>

        <geometry>
          <mesh filename="package://mars_rover/meshes/visual/${wheel_mesh}.obj"/>
        </geometry>

        <material name="Black"/>

      </visual>


      <!-- Collision is local to the wheel axle -->

      <collision>

        <origin xyz="0 0 0"
                rpy="0 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

      </collision>


      <xacro:cylinder_inertia
          mass="${wheel_mass}"
          radius="${wheel_radius}"
          length="${wheel_width}"/>

    </link>


    <!-- ===================================================== -->
    <!-- ACTUAL WHEEL ROTATION JOINT                           -->
    <!-- ===================================================== -->

    <joint name="${wheel_name}_wheel_joint"
           type="continuous">

      <parent link="${wheel_name}_motor_link"/>
      <child link="${wheel_name}_wheel_link"/>

      <!--
        THIS is the important change.

        Put the wheel-link frame directly at the physical axle.
      -->

      <origin xyz="${x} ${y} ${z}"
              rpy="0 0 0"/>

      <!-- Your wheel's native axle is X -->

      <axis xyz="1 0 0"/>

      <limit
          effort="30"
          velocity="30"/>

      <dynamics
          damping="0.1"
          friction="0.1"/>

    </joint>

  </xacro:macro>

</robot>
