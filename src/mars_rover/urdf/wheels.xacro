<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="wheel" params="
    wheel_name
    parent
    wheel_mesh
    motor_mesh
    x
    y
    z">

  <!-- ================= Motor ================= -->

  <link name="${wheel_name}_motor_link">

    <visual>
      <geometry>
        <mesh filename="package://mars_rover/meshes/visual/${motor_mesh}.obj"/>
      </geometry>

      <material name="Silver"/>

    </visual>

  </link>

  <joint
      name="${wheel_name}_motor_joint"
      type="fixed">

      <parent link="${parent}"/>

      <child link="${wheel_name}_motor_link"/>

      <origin xyz="${x} ${y} ${z}"
              rpy="0 0 0"/>

  </joint>

  <!-- ================= Wheel ================= -->

  <link name="${wheel_name}_wheel_link">

<visual>

  <origin xyz="0 0 0"
          rpy="0 0 0"/>

  <geometry>
    <mesh filename="package://mars_rover/meshes/visual/${wheel_mesh}.obj"/>
  </geometry>

  <material name="Black"/>

</visual>

    <collision>

      <origin rpy="0 1.57079632679 0"/>

      <geometry>

        <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

      </geometry>

    </collision>

    <xacro:cylinder_inertia
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        length="${wheel_width}"/>

  </link>

  <joint
      name="${wheel_name}_wheel_joint"
      type="continuous">

      <parent link="${wheel_name}_motor_link"/>

      <child link="${wheel_name}_wheel_link"/>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <axis xyz="1 0 0"/>

      <limit
          effort="30"
          velocity="30"/>

      <dynamics
          damping="0.1"
          friction="0.1"/>

  </joint>

</xacro:macro>

</robot>

